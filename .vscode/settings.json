{
  "editor.defaultFormatter": "trunk.io",
  "json.schemaDownload.trustedDomains": {
    "https://docs.renovatebot.com": true,
    "https://raw.githubusercontent.com/googleapis/release-please/": true,
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json": true
  },
  "peacock.color": "#a9b665",
  "trunk.addToolsToPath": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#bcc688",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#bcc688",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#488a97",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#bcc688",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#bcc688",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "sash.hoverBorder": "#bcc688",
    "statusBar.background": "#a9b665",
    "statusBar.debuggingBackground": "#7265b6",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#15202b",
    "statusBar.inactiveBackground": "#a9b665",
    "statusBarItem.hoverBackground": "#909d4b",
    "statusBarItem.remoteBackground": "#3e7782",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#a9b665",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#a9b66599",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml"
  ],
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    "https://static.trunk.io/pub/trunk-yaml-schema.json": ".trunk/trunk.yaml"
  }
}
