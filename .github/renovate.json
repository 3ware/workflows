{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>3ware/renovate-config"],
  "packageRules": [
    {
      "description": "Actions within reusable workflows use feat prefix to trigger a release",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/reusable-*.yaml"],
      "commitMessagePrefix": "feat(actions){{#if isMajor}}!{{/if}}: ",
      // adding review-required prevents auto-approve workflow running
      "labels": ["reusable-workflow", "review-required"]
    },
    {
      "description": "Action updates in reusable-trunk-code-quality",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/reusable-trunk-code-quality.yaml"],
      "commitMessagePrefix": "feat(trunk){{#if isMajor}}!{{/if}}: "
    },
    {
      "description": "Action updates in reusable-validate-pr-title",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/reusable-validate-pr-title.yaml"],
      "commitMessagePrefix": "feat(pr-title){{#if isMajor}}!{{/if}}: "
    }
  ]
}
